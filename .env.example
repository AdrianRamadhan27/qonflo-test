# Local PostgreSQL example. Replace both passwords before using it.
# The admin connection is used only by database setup scripts.
ADMIN_DATABASE_URL=postgresql://postgres:admin-password@localhost:5432/taskline
DATABASE_URL=postgresql://qonflo_app:app-password@localhost:5432/taskline
DATABASE_SSL=false
PORT=3001

# For Supabase, use the transaction pooler URL and set DATABASE_SSL=true.
# Runtime username: qonflo_app.PROJECT_REF; admin username: postgres.PROJECT_REF.
# Set DATABASE_SSL_CA to the PEM certificate from Supabase's Database Settings.
# Quoted multiline values work in this file; use the same PEM value on the host.
